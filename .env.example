# Copy to .env and set local values. Never commit .env.
# Default: free local Ollama model, used by both n8n workflows.
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2:3b
OPENAI_API_URL=http://ollama:11434/v1/chat/completions
# Google News RSS is used for Phase 1 discovery: no paid search API key is needed.
MAX_SEARCH_RESULTS=5
# Generate a long random value before production use; do not change it after n8n stores credentials.
N8N_ENCRYPTION_KEY="29e99d5fd3f25661f9a0c2062b8dad2db533596455e681a123479b74f837f361"
# Leave these local values until ngrok gives you your assigned dev domain.
# Then set both values to that HTTPS URL, for example https://abc123.ngrok-free.dev/
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
