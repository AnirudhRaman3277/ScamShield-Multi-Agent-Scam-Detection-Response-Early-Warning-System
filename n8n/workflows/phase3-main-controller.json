    {
      "parameters": {
        "jsCode": "const c = $input.first().json;\nconst state = c.case_state ?? {};\nconst alert = state.final_alert ?? {};\nconst text = typeof alert.public_message === 'string' ? alert.public_message.trim() : '';\nconst allowed = state.verification_status === 'APPROVED'\n  && state.verification?.publication_eligible === true\n  && c.last_message?.message_type === 'ALERT_APPROVED'\n  && Array.isArray(alert.evidence_refs)\n  && alert.evidence_refs.length > 0\n  && text.length > 0;\nreturn [{ json: {\n  ...c,\n  publication_allowed: allowed,\n  publication_reason: allowed ? 'All approval checks passed.' : 'Publication guard rejected this case.',\n  telegram_text: allowed ? text : ''\n} }];"
      },
