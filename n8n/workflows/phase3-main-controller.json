    {
      "parameters": {
        "jsCode": "const payload = $input.first().json.body ?? $input.first().json;\nconst narrative = String(payload.narrative ?? '').trim();\nif (!narrative) throw new Error('A report narrative is required.');\nconst now = new Date().toISOString();\nconst caseId = `SCAM-${Date.now()}`;\nconst evidence = [\n  ['Sender', payload.sender],\n  ['Claimed organisation', payload.organisation],\n  ['Website or profile', payload.url],\n  ['Payment request', payload.payment_reference],\n  ['Message text', payload.evidence_text],\n].filter(([, value]) => String(value ?? '').trim()).map(([name, text]) => ({ name, text: String(text).trim() }));\nreturn [{ json: {\n  case_state: { case_id: caseId, state_version: 0, suspected_scam: narrative, sources: [], evidence: [], indicators: [], analysis: null, confidence: { search: null, analysis: null, verification: null, alert: null }, verification_status: 'IN_PROGRESS', conflicts: [], missing_information: [], research_count: 0, revision_count: 0, retry_counts: { search: 0, telegram: 0 }, agent_history: [], final_alert: null, created_at: now, updated_at: now },\n  user_submission: { narrative, country: 'IN', evidence },\n  incoming_message: { case_id: caseId, sender: 'user_intake', recipient: 'scam_analysis_agent', message_type: 'ANALYSIS_REQUEST', objective: 'Structure this report and decide the next safe step.', evidence_refs: [], findings: [], confidence: 0, rationale: 'Submitted through the ScamShield test frontend.', missing_information: [], requested_action: 'ANALYSE_USER_REPORT', recommended_action: 'SEND_TO_ANALYSIS', status: 'IN_PROGRESS', timestamp: now }\n} }];"
      },
